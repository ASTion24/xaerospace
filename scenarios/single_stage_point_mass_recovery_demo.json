{
  "schema_version": 1,
  "name": "Point-mass dual-deploy sounding rocket",
  "description": "A three-degree-of-freedom ascent followed by deterministic drogue and main parachute recovery.",
  "backend": "rocketpy",
  "dynamics": "single_stage_point_mass_3dof_recovery",
  "environment": {
    "latitude_deg": 32.990254,
    "longitude_deg": -106.974998,
    "elevation_m": 1400.0,
    "atmospheric_model": "standard_atmosphere"
  },
  "vehicle": {
    "radius_m": 0.075,
    "dry_mass_without_motor_kg": 12.0,
    "center_of_mass_without_motor_m": 0.0,
    "drag_coefficient_power_on": 0.42,
    "drag_coefficient_power_off": 0.48,
    "weathercock_coefficient": 0.0
  },
  "motor": {
    "thrust_curve": [
      [0.0, 0.0],
      [0.05, 1200.0],
      [0.2, 1050.0],
      [1.0, 900.0],
      [2.0, 780.0],
      [2.8, 350.0],
      [3.0, 0.0]
    ],
    "dry_mass_kg": 1.5,
    "propellant_initial_mass_kg": 4.0,
    "burn_time_s": 3.0
  },
  "recovery": {
    "parachutes": [
      {
        "id": "drogue",
        "cd_s_m2": 0.8,
        "trigger": {
          "kind": "apogee"
        },
        "sampling_rate_hz": 50.0,
        "lag_s": 0.5
      },
      {
        "id": "main",
        "cd_s_m2": 8.0,
        "trigger": {
          "kind": "descending_altitude",
          "altitude_agl_m": 250.0
        },
        "sampling_rate_hz": 50.0,
        "lag_s": 0.7
      }
    ]
  },
  "launch": {
    "rail_length_m": 5.0,
    "inclination_deg": 85.0,
    "heading_deg": 90.0,
    "max_time_s": 180.0,
    "max_time_step_s": 0.05
  },
  "output": {
    "sample_interval_s": 0.05
  }
}
